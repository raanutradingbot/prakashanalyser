# ---- Market data (US stocks & ETFs) ----
# Which provider to use: "alpaca" | "polygon" | "demo"
# "demo" generates realistic synthetic prices so you can run the app without any keys.
DATA_PROVIDER=demo

# Alpaca Market Data (free tier uses the IEX feed; paid "sip" covers all US exchanges)
# https://alpaca.markets/  -> Paper trading account -> API keys
# Put your real keys in .env.local, never here (this file is checked into git).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex

# Polygon.io (now also branded Massive) stock aggregates
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.polygon.io

# ---- Optional AI written summary ----
# Leave empty to disable. The rule-based analysis works without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---- App ----
# Cache TTL for price data, in seconds
CACHE_TTL_SECONDS=300
# Cache TTL for the news feed, in seconds
NEWS_CACHE_TTL_SECONDS=900
# Cache TTL for the "stocks in an uptrend" home-page scan, in seconds
SCAN_CACHE_TTL_SECONDS=1800
# Max analyses per IP per minute on /api/analyze
RATE_LIMIT_PER_MINUTE=30
